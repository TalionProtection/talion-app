{
  "expo": {
    "name": "Talion's Eye",
    "slug": "talion-crisis-comm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "talioncrisiscomm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talioncrisiscomm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSDocumentsFolderUsageDescription": "Talion's Eye needs access to documents for sharing files in chat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e3a5f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.talioncrisiscomm",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCb6CdyRM6wFdcuv-Hrn4nxuJQL0I9U1eY"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Talion's Eye needs your location to track responders during emergencies.",
          "locationAlwaysPermission": "Allow Talion's Eye to always access your location for emergency response tracking.",
          "locationWhenInUsePermission": "Allow Talion's Eye to use your location during emergencies.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Talion's Eye needs your microphone to talk on PTT channels.",
          "cameraPermission": "Talion's Eye uses your camera to attach photos to incident reports, patrol logs, and messages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Talion's Eye needs access to your photos to attach them to incident reports, patrol logs, messages, and your profile picture.",
          "cameraPermission": "Talion's Eye uses your camera to attach photos to incident reports, patrol logs, and messages."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c2e1727-8917-4cbe-a0d0-13448304582c"
      }
    }
  }
}
