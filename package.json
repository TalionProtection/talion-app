{
  "name": "safenet-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n metro,server -c blue,green \"pnpm dev:metro\" \"pnpm dev:server\"",
    "dev:metro": "expo start --web",
    "dev:server": "tsx server/index.ts",
    "build": "expo export --platform web && esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outdir=dist && esbuild shared/browser-entry.ts --bundle --format=iife --outfile=server/dispatch-web/shared.bundle.js && esbuild shared/browser-entry.ts --bundle --format=iife --outfile=server/admin-web/shared.bundle.js",
    "start": "NODE_ENV=production node dist/index.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@livekit/react-native": "^2.10.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.103.0",
    "@types/multer": "^2.1.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "^14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "express": "^5.2.1",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.15.1",
    "multer": "^2.1.1",
    "pdfkit": "^0.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "sharp": "^0.35.3",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/react": "~19.1.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "esbuild": "0.27.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.1"
  },
  "pnpm": {
    "overrides": {
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "lru-cache@5.1.1>yallist": "^3.1.1"
    }
  },
  "private": true
}
