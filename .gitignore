# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/

web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# server build output (esbuild bundle) - Render rebuilds this fresh from
# source on every deploy, it's never actually read from what's committed
/dist

# Persisted runtime data (regenerated from seed on startup)
data/
*.ipa

# Supabase CLI local link cache (machine-specific, no project config to share)
supabase/.temp/
